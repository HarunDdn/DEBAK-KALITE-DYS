<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS HttpPlatformHandler — DebakDYS (192.168.0.245)
  Havuz: DebakDYSPool
  Fiziksel kök: C:\inetpub\wwwroot\debakdys  (= \\192.168.0.245\wwwroot\debakdys)
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="C:\Program\python.exe"
                  arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% wsgi:application"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\wwwroot\debakdys\logs\httpplatform"
                  startupTimeLimit="60"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="C:\inetpub\wwwroot\debakdys;C:\inetpub\wwwroot\debakdys\.venv\Lib\site-packages" />
        <environmentVariable name="PYTHONHOME" value="C:\Program" />
        <environmentVariable name="VIRTUAL_ENV" value="C:\inetpub\wwwroot\debakdys\.venv" />
        <environmentVariable name="DYS_ENV" value="production" />
        <environmentVariable name="DYS_UPLOAD_FOLDER" value="\\192.168.0.249\kalite\AL DOSYALAR" />
        <environmentVariable name="DYS_TEMP_FOLDER" value="C:\inetpub\wwwroot\debakdys\temp" />
        <!-- DYS_FILESHARE_USER / DYS_FILESHARE_PASSWORD (dosya paylaşımı hesabı) BURAYA YAZILMAZ: sunucudaki .env dosyasına yazılır (git'e girmez). -->
      </environmentVariables>
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
