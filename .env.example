# DYS — Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayın. .env git'e eklenmez.

# ── Temel ────────────────────────────────────────────────────────────────
DYS_ENV=production
DYS_SECRET_KEY=
# Ya tam URL:
# DYS_DATABASE_URL=mssql+pyodbc://USER:PASS@HOST/DB?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# Ya da parçalı MSSQL (önerilen; \ doğru işlenir):
DYS_DATABASE_URL=
DYS_MSSQL_SERVER=DEBAKNETSIS\DB20
DYS_MSSQL_DATABASE=DBKDYS
# true = Windows Auth (UID/PWD yok); false = SQL Auth
DYS_MSSQL_TRUSTED=false
DYS_MSSQL_USER=sa
DYS_MSSQL_PASSWORD=
DYS_MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# IIS sitesi DebakDYS (kök yayın; PREFIX boş)
DYS_PREFIX=
DYS_APP_BASE_URL=http://192.168.0.245:8081

DYS_UPLOAD_FOLDER=\\192.168.0.249\kalite\AL DOSYALAR
DYS_TEMP_FOLDER=C:\inetpub\wwwroot\debakdys\temp
DYS_MAX_UPLOAD_MB=50

DYS_REDIS_URL=
DYS_FORCE_HTTPS=false
DYS_SESSION_HOURS=8
DYS_AUTO_SEED=false
DYS_SHOW_STARTUP_CREDENTIALS=false

DYS_MAX_LOGIN_ATTEMPTS=5
DYS_LOGIN_LOCK_MINUTES=15
DYS_MIN_PASSWORD_LENGTH=8
DYS_LOGIN_RATELIMIT=10 per minute

DYS_NOTIFICATIONS_ENABLED=true
DYS_SMTP_HOST=
DYS_SMTP_PORT=587
DYS_SMTP_USER=
DYS_SMTP_PASS=
DYS_SMTP_FROM=dys@debak.local
DYS_SMTP_USE_TLS=true

DYS_DEFAULT_LOCALE=tr
DYS_SCHEDULER_ENABLED=false
DYS_DAILY_DIGEST_HOUR=8
DYS_CAPA_REMINDER_DAYS=7
DYS_CAPA_REMINDER_HOUR=9

# ── 11 süreçlik yeni yapı (2026) ───────────────────────────────
# Doküman numarası biçimi: debak = D04 P02 (yeni) · eski = D04-PR-001 (geçiş gününe kadar eski bırakılabilir)
DYS_NUMARA_FORMATI=debak
# Her form kaydı / onayı sonrası form başına Excel yazılan klasör (IIS havuz hesabına yazma yetkisi gerekir)
DYS_FORM_VERI_KLASORU=\192.168.0.249\kalite\YENİ YAPI\Form Verileri
# Office dosyalarının hazır PDF önizlemeleri (salt okunur yeterli) ve sunucuda üretilen önizlemeler için yazılabilir klasör
DYS_ONIZLEME_EK_KLASORLER=\192.168.0.249\kalite\YENİ YAPI\DYS Aktarım\Önizleme PDF
DYS_ONIZLEME_KLASORU=
# true yapılırsa eski (pasif) süreçler haritada gösterilir; eski yapı temizlendikten sonra false kalmalı
DYS_ESKI_SURECLERI_GOSTER=false
